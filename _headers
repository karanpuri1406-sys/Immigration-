# Cloudflare Pages headers — equivalent of the [[headers]] blocks in netlify.toml.
# Netlify ignores this file; Cloudflare ignores netlify.toml. Both can coexist.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Images and icons are content-stable, so cache them hard.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# CSS and JS are versioned via ?v= in the HTML, so they can cache hard too.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate so edits go live immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
